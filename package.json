{
  "name": "varianthub-site",
  "version": "0.6.2",
  "description": "VariantHub: compare live UI variants from your own project side by side. Website, local runner and React viewer.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattiamichini-design/varianthub.git"
  },
  "bugs": {
    "url": "https://github.com/mattiamichini-design/varianthub/issues"
  },
  "scripts": {
    "dev": "npm run build --workspace varianthub-core && next dev",
    "build": "npm run build --workspace varianthub-core && next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:core": "npm test --workspace varianthub-core",
    "typecheck": "npm run typecheck --workspace varianthub-core && tsc --noEmit",
    "test:runner": "npm test --workspace varianthub",
    "build:packages": "npm run build --workspace varianthub-core && npm run build --workspace varianthub",
    "verify:packages": "node scripts/verify-packages.mjs",
    "audit:history": "node scripts/audit-history.mjs",
    "capture:marketing": "node scripts/capture-marketing.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.525.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "varianthub-core": "0.6.2",
    "@paper-design/shaders-react": "^0.0.80",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "radix-ui": "^1.6.7",
    "varianthub": "0.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "esbuild": "0.28.2",
    "postcss": "8.5.23"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
